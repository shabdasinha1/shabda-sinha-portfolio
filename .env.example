# Public URL of the deployed site, without a trailing slash.
# Used at build time for the canonical URL, og:url, og:image and sitemap.xml.
# Leave unset until the final domain is known: those tags are then omitted
# (nothing invalid is published). On Cloudflare Pages, set it under
# Settings → Environment variables → Production, not in a committed file.
#
# Example (replace with the real domain):
# VITE_SITE_URL=https://your-domain.example
VITE_SITE_URL=
